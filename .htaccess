RewriteEngine On

# One canonical host: HTTPS without www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.qazdevstudio\.kz$ [NC]
RewriteRule ^ https://qazdevstudio.kz%{REQUEST_URI} [R=301,L,NE]

# Keep HTML fresh after deploys; versioned static files may be cached.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:css|js|svg|webp|png|jpg|jpeg|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
